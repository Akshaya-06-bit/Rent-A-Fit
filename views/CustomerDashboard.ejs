<!DOCTYPE html>
<html>
<head>
  <title>Customer Dashboard</title>
  <link rel="stylesheet" href="/stylesheets/consumer.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <h1>Welcome</h1>
  <h3>Total Spent: ₹<%= totalSpent %></h3>

  <% if (orders && orders.length > 0) { %>
    <canvas id="monthlySpendingChart" width="600" height="300"></canvas>

    <script>
      const labels = <%- JSON.stringify(chartLabels) %>;
      const data = <%- JSON.stringify(chartData) %>;

      const ctx = document.getElementById('monthlySpendingChart').getContext('2d');
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Monthly Spending (₹)',
            data: data,
            fill: true,
            borderColor: '#0046be', 
            backgroundColor: 'rgba(0, 70, 190, 0.05)', 
            borderWidth: 2,
            pointBackgroundColor: '#0046be',
            pointHoverRadius: 6,
            tension: 0.25
          }]
        },
        options: { 
          responsive: true,
          plugins: {
            legend: {
              labels: {
                font: { family: 'Montserrat', size: 12, weight: '600' }
              }
            }
          },
          scales: {
            y: { 
              grid: { color: '#f0f0f0' },
              ticks: { font: { family: 'Montserrat' } }
            },
            x: { 
              grid: { display: false },
              ticks: { font: { family: 'Montserrat' } }
            }
          }
        }
      });
    </script>
  <% } else { %>
    <p>No orders yet.</p>
  <% } %>
</body>
</html>